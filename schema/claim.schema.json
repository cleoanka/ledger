{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cleoanka/ledger/blob/main/schema/claim.schema.json",
  "title": "Ledger claim",
  "description": "One re-runnable claim. value is the number published at the pinned commit, never a re-run result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project", "lab_page", "sentence", "value", "display", "unit", "comparator", "tolerance", "conditions", "repo", "commit", "setup", "command", "result_path", "result_key", "adapter", "rerun", "status", "history", "head_check", "refutations", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*-\\d{3}$"},
    "project": {"enum": ["atlas", "aura-mind", "volterra", "zeno", "unscratchable", "kairos"]},
    "lab_page": {"oneOf": [{"type": "string", "pattern": "^/lab/[a-z0-9-]+/$"}, {"type": "null"}]},
    "essay_url": {"type": "string", "pattern": "^https://"},
    "sentence": {"$ref": "#/$defs/text"},
    "value": {"type": "number"},
    "display": {"$ref": "#/$defs/text"},
    "unit": {"$ref": "#/$defs/text"},
    "comparator": {"$ref": "#/$defs/comparator"},
    "tolerance": {"type": "number"},
    "guards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "comparator", "tolerance"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "comparator": {"$ref": "#/$defs/comparator"},
          "tolerance": {"type": "number"}
        }
      }
    },
    "conditions": {"$ref": "#/$defs/text"},
    "repo": {"type": "string", "pattern": "^github\\.com/cleoanka/[A-Za-z0-9._-]+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "setup": {"type": "string"},
    "command": {"type": "string", "minLength": 1},
    "result_path": {"type": "string"},
    "result_key": {"type": "string", "minLength": 1},
    "adapter": {"enum": ["json_select", "md_table", "junit_failures", "zeno_counts", "stdout_regex"]},
    "rerun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "budget_min", "runs_on"],
      "properties": {
        "class": {"enum": ["nightly", "weekly", "manual"]},
        "budget_min": {"type": "integer", "minimum": 1, "maximum": 10},
        "runs_on": {"type": "string", "pattern": "^(ubuntu-24\\.04|macos-15|local:[a-z0-9-]+)$"}
      }
    },
    "status": {"$ref": "#/$defs/status"},
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "status", "reason", "by"],
        "properties": {
          "date": {"$ref": "#/$defs/date"},
          "status": {"$ref": "#/$defs/status"},
          "reason": {"$ref": "#/$defs/text"},
          "by": {"enum": ["cleoanka", "ci"]}
        }
      }
    },
    "head_check": {"type": "boolean"},
    "refutations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_url", "date", "by", "outcome"],
        "properties": {
          "issue_url": {"type": "string", "pattern": "^https://github\\.com/cleoanka/ledger/issues/\\d+$"},
          "date": {"$ref": "#/$defs/date"},
          "by": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["accepted", "rejected", "duplicate", "weakened"]}
        }
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^([A-Za-z0-9._-]+@[0-9a-f]{7}:[^\\s#]+(#\\S+)?|SOURCES\\.md:\\S+)$"}}
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tr", "en"],
      "properties": {"tr": {"type": "string"}, "en": {"type": "string"}}
    },
    "comparator": {"enum": ["approx", "le", "ge", "eq"]},
    "status": {"enum": ["standing", "drifting", "weakened", "refuted", "retracted", "manual"]},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
